rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // La nouvelle version n'utilise pas Firestore : tout est refusé par sécurité.
    // (L'ancienne version avait des règles ouvertes à tous : read, write: if true.)
    // Quand la synchronisation sera ajoutée, on mettra : allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
